# Public URL of the multiplayer server.
# Used by the app to connect for "Play with Friends".
#
# For local development against your LAN server you can leave this unset —
# the app figures out the dev machine's address automatically.
#
# For a production build (APK / web) that friends use over the internet,
# point this at your public server, e.g.:
EXPO_PUBLIC_SERVER_URL=http://YOUR_ORACLE_IP:3001