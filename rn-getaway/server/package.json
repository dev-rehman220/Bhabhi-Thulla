{
  "name": "get-away-thulla-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "health": "node -e \"fetch('http://localhost:'+(process.env.PORT||3001)+'/health').then(async r=>{console.log(await r.text());process.exit(r.ok?0:1)}).catch(()=>{console.error('Server is not reachable');process.exit(1)})\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^12.7.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
